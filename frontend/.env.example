# Apunta al backend local (por defecto Spring Boot en puerto 8080)
REACT_APP_API_URL=http://localhost:8080
REACT_APP_BACKEND_URL=http://localhost:8080

# En producción (ej. Vercel) usa la URL pública de tu backend:
# REACT_APP_API_URL=https://tu-backend.up.railway.app
# REACT_APP_BACKEND_URL=https://tu-backend.up.railway.app
