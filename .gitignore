# =============================================================
# Dagon Project — .gitignore
# =============================================================

# ----- IDE y editores -----
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# ----- Dependencias -----
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----- Testing -----
coverage/
*.lcov

# ----- Builds de producción -----
frontend/build/
backend/target/
dist/
out/
*.tsbuildinfo
next-env.d.ts

# ----- Logs -----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb
*.log

# ----- Sistema operativo -----
.DS_Store
Thumbs.db
*.pem

# ----- Python -----
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/

# ----- Herramientas de desarrollo -----
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac
.cache/

# ----- Deployment -----
.vercel

# =============================================================
# 🔒 ARCHIVOS SENSIBLES — NUNCA COMMITEAR
# =============================================================

# --- Variables de entorno (contienen secretos) ---
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging

# Frontend .env (excepto el example)
frontend/.env
frontend/.env.local
frontend/.env.development
frontend/.env.production
frontend/.env.*.local

# Backend .env
backend/.env
backend/.env.*

# --- Backend: application.properties con credenciales reales ---
# SOLO commitear el .example, NUNCA el archivo real
backend/src/main/resources/application.properties
backend/src/main/resources/application-local.properties
backend/src/main/resources/application-dev.properties
backend/src/main/resources/application-prod.properties

# --- Archivos .example SÍ se commitean (plantillas sin secretos) ---
!.env.example
!frontend/.env.example
!backend/src/main/resources/application.properties.example

# --- Tokens, llaves y credenciales ---
*token.json*
*credentials.json*
*.key
*.keystore
*.jks
*.p12

# =============================================================
# 📦 ARCHIVOS GRANDES Y BACKUPS
# =============================================================

# Archivos comprimidos
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Backups y dumps de BD (pueden contener datos reales)
*.dump
*.backup
*backup*.sql
*respaldo*.sql
*dump*.sql

# Uploads de usuarios (fotos de perfil, etc.)
uploads/
backend/uploads/

# Archivos PDF grandes
para dilman/*.pdf

# =============================================================
# 📝 NOTA PARA COLABORADORES
# =============================================================
# Para configurar tu entorno local:
#   1. cp frontend/.env.example frontend/.env
#   2. cp backend/src/main/resources/application.properties.example \
#         backend/src/main/resources/application.properties
#   3. Edita ambos archivos con tus credenciales locales
#   4. Consulta el README.md para instrucciones completas
# =============================================================