# Opcion 1: Railway suele entregar una URL completa.
DATABASE_URL=postgresql://usuario:password@host:puerto/base

# Opcion 2: variables separadas de PostgreSQL.
# PGHOST=host
# PGPORT=5432
# PGDATABASE=base
# PGUSER=usuario
# PGPASSWORD=password

# Si el sandbox usa otro rol, configura estas variables.
# DAGON_SANDBOX_URL=postgresql://usuario_sandbox:password@host:puerto/base
# DAGON_SANDBOX_USERNAME=app_sandbox_user
# DAGON_SANDBOX_PASSWORD=password

# Servicios externos opcionales.
# GEMINI_API_KEY=tu_api_key
# DAGON_MPI_URL=http://127.0.0.1:5001
