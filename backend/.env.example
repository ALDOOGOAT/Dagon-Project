# Copia este archivo como backend/.env y llena los valores reales.
# No subas backend/.env al repositorio. Ninguna credencial tiene valor por defecto en
# application.properties: todo lo de abajo debe venir de este archivo o del servidor.

# Opcion 1: URL JDBC directa para Spring.
SPRING_DATASOURCE_URL=jdbc:postgresql://host:puerto/base
SPRING_DATASOURCE_USERNAME=usuario_app
SPRING_DATASOURCE_PASSWORD=coloca_la_password_real

# Opcion 2: Railway/hosting puede entregar una URL completa.
# Se aceptan formatos jdbc:postgresql://..., postgresql://... y postgres://...
# DATABASE_URL=postgresql://usuario:password@host:puerto/base
# DATABASE_PUBLIC_URL=postgresql://usuario:password@host:puerto/base

# Opcion 3: variables separadas de PostgreSQL.
# PGUSER=usuario_app
# PGPASSWORD=coloca_la_password_real

DAGON_SANDBOX_URL=jdbc:postgresql://host:puerto/base
DAGON_SANDBOX_USERNAME=app_sandbox_user
DAGON_SANDBOX_PASSWORD=coloca_la_password_sandbox_real

# OBLIGATORIA: sin ella el backend no arranca. Minimo 32 bytes. Genera una con: openssl rand -base64 48
DAGON_JWT_SECRET=cambia_este_valor_por_un_secreto_largo_de_32_caracteres_o_mas
DAGON_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

GEMINI_API_KEY=coloca_tu_api_key_si_usas_gemini
GROQ_API_KEY=coloca_tu_api_key_si_usas_groq
# Clawbot: Groq principal; Gemini y Ollama solo si Groq falla.
DAGON_CLAWBOT_PROVIDERS=groq,gemini,ollama
DAGON_CLAWBOT_GROQ_MODEL=openai/gpt-oss-20b
DAGON_CLAWBOT_GEMINI_MODEL=gemini-flash-lite-latest

# Fotos de perfil: en Railway monta un volumen en /data y usa /data/uploads.
DAGON_UPLOADS_DIR=uploads

DAGON_MPI_URL=http://127.0.0.1:5001

# IO: usa GEMINI_API_KEY/GROQ_API_KEY definidos arriba. Local primero, sin llamadas si listo.
DAGON_IO_IA_ENABLED=true
DAGON_IO_IA_PROVIDERS=groq,gemini,ollama
DAGON_IO_IA_TIMEOUT_SECONDS=15
DAGON_IO_IA_MAX_TOKENS=2000
DAGON_IO_IA_ATTEMPTS=1
DAGON_IO_GEMINI_MODEL=gemini-flash-lite-latest
DAGON_IO_GROQ_MODEL=openai/gpt-oss-20b
DAGON_IO_GROQ_FALLBACK_MODELS=openai/gpt-oss-120b
DAGON_IO_OLLAMA_ENABLED=false
DAGON_IO_OLLAMA_MODEL=qwen2.5:7b
DAGON_IO_OLLAMA_URL=http://127.0.0.1:11434/api/chat

# false solo para modelos Groq que no admitan json_schema/strict.
DAGON_IO_GROQ_STRUCTURED=true
